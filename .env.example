# ---------------------------------------------------------------------------
# QueryShield - variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# ---------------------------------------------------------------------------

# URL publique de l'application (utilisee pour les redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:4321

# --- Moteur d'analyse -------------------------------------------------------
# Phase 1 (par defaut) : moteur heuristique embarque dans Next.js.
# Aucune variable requise, tout tourne en local, rien n'est persiste.

# Phase 2 : microservice Python (LLM semantique).
# Si renseigne, l'API /api/analyze appelle ce service et fusionne ses
# constats avec ceux du moteur heuristique.
# QUERYSHIELD_ENGINE_URL=http://127.0.0.1:8100
# QUERYSHIELD_ENGINE_TOKEN=change-me
# QUERYSHIELD_ENGINE_TIMEOUT_MS=8000

# --- Persistance (licences, quotas, limitation de debit) --------------------
# Les licences, les compteurs de quota et les compteurs de debit sont
# persistants : ils survivent a un redemarrage et sont partages entre les
# instances d'un deploiement serverless.
#
# Fichier SQLite. En production, pointer vers un volume persistant et non
# vers le systeme de fichiers ephemere de la plateforme.
# QUERYSHIELD_DB_FILE=./data/queryshield.db

# Pilote de stockage : sqlite (defaut) ou memory.
# memory n'est PAS durable : il n'existe que pour les tests et le depannage.
# QUERYSHIELD_DB_DRIVER=sqlite

# --- Limitation de debit (protection anti-abus) -----------------------------
# Les adresses IP sont condensees (HMAC-SHA256) avec un sel renouvele chaque
# jour : aucune adresse en clair n'est ecrite. Renouveler ce sel invalide les
# compteurs en cours, sans autre consequence.
# QUERYSHIELD_IP_SALT=chaine-aleatoire-longue

# Nombre de proxys de confiance devant l'application (nginx, Cloudflare...).
# Sert a extraire la bonne adresse dans X-Forwarded-For. 0 = ne faire
# confiance a aucun en-tete (defaut, le plus sur si l'application est exposee
# directement).
# QUERYSHIELD_TRUSTED_PROXY_HOPS=1

# Desactive la limitation de debit (tests de charge uniquement).
# QUERYSHIELD_RATELIMIT_DISABLED=false

# --- Facturation (Stripe) ---------------------------------------------------
# Laisser vide en developpement : les boutons d'abonnement restent inertes
# et affichent un message explicite au lieu de casser.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_YEARLY=price_xxx
# STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
# STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# --- Verification de site (optionnel) ---------------------------------------
# Le verificateur de site n'ouvre JAMAIS le site analyse. Les verifications
# reseau se limitent a interroger l'annuaire des domaines (RDAP, pour la date
# d'enregistrement et le registrar) et, si une cle est fournie, un service de
# reputation. Ces services tiers recoivent le nom de domaine, jamais le site.
#
# Interrupteur general des verifications reseau. A false, la verification reste
# purement statique : aucun appel sortant n'est effectue.
# QUERYSHIELD_SITE_ACTIVE=true

# Cle de l'API Google Safe Browsing. Sans elle, la verification de reputation
# est ignoree (le rapport l'indique explicitement au lieu de supposer que le
# site est propre).
# GOOGLE_SAFE_BROWSING_API_KEY=

# --- Quotas (freemium) ------------------------------------------------------
# Nombre d'analyses offertes par jour et par identifiant anonyme.
QUERYSHIELD_FREE_DAILY_QUOTA=10
