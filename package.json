{
  "name": "queryshield",
  "version": "0.1.0",
  "private": true,
  "description": "QueryShield - analyse anti-arnaque des messages (e-mail, SMS, messagerie instantanee). Aide a la decision par score de risque.",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "next build",
    "start": "next start -p 4321",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "tools:build": "tsc -p tsconfig.tools.json",
    "test:engine": "npm run tools:build && node .tools/tools/test-engine.js",
    "test:i18n": "npm run tools:build && node .tools/tools/test-i18n.js",
    "test:store": "npm run tools:build && node .tools/tools/test-store.js",
    "test": "npm run tools:build && node .tools/tools/test-engine.js && node .tools/tools/test-i18n.js && node .tools/tools/test-store.js",
    "license": "npm run tools:build && node .tools/tools/license.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "clsx": "2.1.1",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
